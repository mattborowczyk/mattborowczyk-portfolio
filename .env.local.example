# Sanity — get these from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token — enables draft preview (the Presentation tool in the Studio,
# and /api/draft/enable). Viewer scope is enough: it is used to read unpublished
# documents and to validate the one-time preview secret the Studio creates.
# Create at: https://sanity.io/manage → API → Tokens
#
# Optional. Without it the site simply never leaves published content:
# /api/draft/enable returns 401 and Presentation shows the published site.
SANITY_API_TOKEN=your_sanity_api_token

# MailerLite — get from https://app.mailerlite.com/integrations/api
MAILERLITE_API_KEY=your_mailerlite_api_key
# The ID of the group/segment subscribers are added to (optional)
MAILERLITE_GROUP_ID=your_group_id

# NOTE: signups use double opt-in — /api/newsletter always creates subscribers
# as "unconfirmed" so MailerLite sends a confirmation email. This REQUIRES
# "Double opt-in for API and integrations" to be ON in MailerLite:
# Account settings → Subscribe settings. With that toggle OFF, subscribers are
# stored as unconfirmed, no email is sent, and they receive no campaigns.

# Security headers — the CSP in next.config.ts is enforced by default. Set this
# to "true" and rebuild to send it as Content-Security-Policy-Report-Only
# instead: violations are logged in the browser console and nothing is blocked,
# which is how a policy change is watched on a deploy preview before it can
# break anything for a visitor. Read at build time, not per request.
# CSP_REPORT_ONLY=true

# NOTE: rate limiting needs no configuration and no credentials. It runs at the
# Netlify edge (netlify/edge-functions/newsletter-guard.ts) and is enforced by
# the platform before any function is invoked, so there is no store to connect.
# It only applies on Netlify — `next dev` does not run edge functions. To
# exercise it locally, use `pnpm dev:netlify`.
